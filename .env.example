# Ghost Data Still Exists - environment template
# Copy to .env and fill in the values. Never commit .env.
#   cp .env.example .env

# --- Credentials (required) --------------------------------------------------
ANTHROPIC_API_KEY=

# --- Model -------------------------------------------------------------------
# One model for every role (verdict, escalation, vision). Effort: low|medium|high|xhigh|max
GHOST_MODEL=claude-sonnet-5-5
GHOST_EFFORT=medium
GHOST_VISION_MODEL=claude-opus-5-5

# --- Agent limits -------------------------------------------------------------
# Guard-refusal retries per case before the deterministic fallback completes it.
GHOST_RETRY_ALLOWANCE=2
# Model-turn limit of the per-case judge loop (the case's tools; raw search needs room).
GHOST_JUDGE_TURN_LIMIT=8
# Model-turn limit of the escalation (open-analysis) loop.
GHOST_ESCALATION_TURN_LIMIT=12
# Cases processed in parallel.
GHOST_CONCURRENCY=4

# --- Paths (relative to the repository root) ---------------------------------
GHOST_DATASET_DIR=dataset
GHOST_OUTPUT_PATH=output.csv
GHOST_CACHE_DIR=.cache
GHOST_TRACE_DIR=traces
# Format ablation: comma-separated parsers to switch off (sql,json,log,text,pdf,image); raw lines stay searchable.
GHOST_DISABLE_PARSERS=

# Model-call parameters (defaults shown)
GHOST_MAX_TOKENS=8192
GHOST_MODEL_TIMEOUT=120
GHOST_VISION_TIMEOUT=180
GHOST_MAX_RETRIES=3
GHOST_READ_WINDOW=25
GHOST_ESCALATION_READ_WINDOW=60
